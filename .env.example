# Local development: copy this file to .dev.vars (gitignored). Wrangler reads
# .dev.vars, not .env, during `bun run dev`.
# Production: wrangler secret put <NAME> --env production
#
# These are every secret on CloudflareEnv (src/lib/db/index.ts). Bindings
# (DB, LIVE_GAME, LIVE_HUB, SCHEDULER, VIEWER_SYNC) come from wrangler.jsonc.
# Public vars (CANONICAL_HOST, VAPID_PUBLIC_KEY, VAPID_SUBJECT, ADMIN_EMAILS)
# are set there too, under env.production.vars.

# Better Auth. BETTER_AUTH_URL is this app's origin (http://localhost:3000 locally).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 bytes, base64. Seals Viewers' Kalshi API keys (docs/adr/0003).
KALSHI_ENCRYPTION_KEY=

# 32 bytes, base64. Seals Viewers' ESPN session cookies (docs/adr/0004).
ESPN_ENCRYPTION_KEY=

# The Odds API key: sharp books' prices for Sharp picks (docs/adr/0006).
ODDS_API_KEY=

# Web Push private key, a JWK. The public key is VAPID_PUBLIC_KEY in wrangler.jsonc.
VAPID_PRIVATE_JWK=
