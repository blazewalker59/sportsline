{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Single source-of-truth Wrangler config, the same shape as dreamteam: the
  // @cloudflare/vite-plugin reads this for dev + `vite build` (which requires
  // `main` to be the source entry), and the production deploy passes the
  // built bundle as wrangler's positional script arg, which overrides `main`:
  //   wrangler deploy dist/server/index.js --env production
  //
  // There is no staging environment. Bindings and vars are not inherited by
  // named environments, so production repeats d1_databases, durable_objects,
  // and vars. `name` is repeated too: omitting it publishes
  // `sportsline-production` instead of `sportsline`. workers_dev,
  // observability, triggers, migrations, assets, and compatibility settings
  // are inherited from the top level.
  "name": "sportsline",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist/client",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sportsline-db",
      "database_id": "bc1c8932-1e2b-439e-bd1f-81340ff30c2f",
      "migrations_dir": "drizzle",
    },
  ],
  // One LiveGame per live Game polls its Source and diffs Plays; one LiveHub
  // relays them to connected Viewers; one Scheduler runs global jobs every
  // minute on its own alarm, in place of a Cron Trigger (docs/adr/0001); one
  // ViewerSync per Viewer runs their Kalshi and fantasy syncing (0005).
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_GAME", "class_name": "LiveGame" },
      { "name": "LIVE_HUB", "class_name": "LiveHub" },
      { "name": "SCHEDULER", "class_name": "Scheduler" },
      { "name": "VIEWER_SYNC", "class_name": "ViewerSync" },
    ],
  },
  // No Cron Triggers: the Scheduler Durable Object runs the schedule sync
  // (docs/adr/0001). Declared empty so deploys remove any registered
  // trigger; leaving `triggers` out keeps whatever was there.
  "triggers": {
    "crons": [],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveGame", "LiveHub"] },
    { "tag": "v2", "new_sqlite_classes": ["Scheduler"] },
    // One ViewerSync per Viewer runs their own syncing (docs/adr/0005).
    { "tag": "v3", "new_sqlite_classes": ["ViewerSync"] },
  ],
  "env": {
    "production": {
      "name": "sportsline",
      // Production is sportsline.dev (a Custom Domain, declared here so every
      // deploy keeps it, as dreamteam does). www and workers.dev stay on but
      // redirect to it (src/server.ts, CANONICAL_HOST). workers_dev is
      // inherited from the top level so the workers.dev host stays on.
      "routes": [
        {
          "pattern": "sportsline.dev",
          "custom_domain": true,
        },
        {
          "pattern": "www.sportsline.dev",
          "custom_domain": true,
        },
      ],
      // Requests on any other host (www, workers.dev) redirect here.
      "vars": {
        "CANONICAL_HOST": "sportsline.dev",
        // Web Push (Alerts): the public half of the VAPID key pair; the
        // private half is the VAPID_PRIVATE_JWK secret.
        "VAPID_PUBLIC_KEY": "BC0pDiE5foLBri7xunT8n5DgXHTk657Xi4tf1lcw6f5ZO2DO7Vz1Lm1JzBPltfQ8cuykUX2Nb-83g-qiNd1tVXs",
        "VAPID_SUBJECT": "https://sportsline.dev",
        // The admin: sees /admin and is pushed about errors (docs/adr/0005).
        "ADMIN_EMAILS": "blazewalker59@gmail.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sportsline-db",
          "database_id": "bc1c8932-1e2b-439e-bd1f-81340ff30c2f",
          "migrations_dir": "drizzle",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "LIVE_GAME", "class_name": "LiveGame" },
          { "name": "LIVE_HUB", "class_name": "LiveHub" },
          { "name": "SCHEDULER", "class_name": "Scheduler" },
          { "name": "VIEWER_SYNC", "class_name": "ViewerSync" },
        ],
      },
    },
  },
}
